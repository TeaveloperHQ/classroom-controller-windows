<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassroomController.Views.ClassroomSetupWindow"
        Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="학급 설정">
    <StackPanel Margin="20" Spacing="14">
        <TextBlock Text="학급 설정" FontSize="18" FontWeight="Bold" />
        <TextBlock Text="관리할 학년/반을 선택하세요. 기기 이름이 해당 학년+반으로 시작하는 태블릿만 표시됩니다."
                   TextWrapping="Wrap" Foreground="#616161" FontSize="12" />

        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="학년" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" Name="GradeBox" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="1" Grid.Column="0" Text="반" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" Name="ClassBox" HorizontalAlignment="Stretch" />
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Grid.Column="0" Name="CancelButton" Content="취소"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Click="OnCancel" />
            <Button Grid.Column="1" Content="확인"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#1976d2" Foreground="White"
                    Click="OnConfirm" />
        </Grid>
    </StackPanel>
</Window>
