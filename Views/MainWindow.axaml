<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:ClassroomController.ViewModels"
        xmlns:v="using:ClassroomController.Views"
        mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="720"
        x:Class="ClassroomController.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Width="480" Height="720"
        MinWidth="380" MinHeight="480"
        Title="교실 관리">

    <Window.Styles>
        <!-- 목록 항목은 카드가 직접 그리므로 ListBoxItem 기본 하이라이트 제거 -->
        <Style Selector="ListBox#DeviceList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,6" />
        </Style>
        <Style Selector="ListBox#DeviceList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#DeviceList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#DeviceList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- ── 헤더 (Teavel 그라데이션 배지) ── -->
        <Border Grid.Row="0" Background="{StaticResource TeavelBrandGradient}"
                BoxShadow="0 2 8 0 #33000000" Padding="0,0,0,16">
            <StackPanel>
                <!-- 제목 행 -->
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="20,18,12,2">
                    <TextBlock Grid.Column="0" Text="교실 관리" Foreground="White"
                               FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="onBrand"
                            Width="40" Height="40" Margin="0,0,4,0"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="OnAppSettingsClick"
                            ToolTip.Tip="허용 앱 설정">
                        <v:LineIcon Kind="grid" Stroke="White" Width="22" Height="22" />
                    </Button>
                    <Button Grid.Column="2" Classes="onBrand"
                            Width="40" Height="40"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            ToolTip.Tip="설정">
                        <v:LineIcon Kind="settings" Stroke="White" Width="22" Height="22" />
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="학급 설정" Click="OnClassroomSettingsClick">
                                    <MenuItem.Icon>
                                        <v:LineIcon Kind="home" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="설정 마법사 다시 하기" Click="OnRerunWizardClick">
                                    <MenuItem.Icon>
                                        <v:LineIcon Kind="refresh" Width="16" Height="16" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- 학년/반 · 태블릿 수 -->
                <TextBlock Text="{Binding Subtitle}" Foreground="#DDFFFFFF"
                           FontSize="13" Margin="20,0,20,2" />
                <!-- Byline -->
                <TextBlock Text="by Teaveloper" Foreground="#AAFFFFFF"
                           FontSize="11" Margin="20,0,20,14" />

                <!-- 자동 종료 대기 바 -->
                <Grid ColumnDefinitions="*,Auto" Margin="20,0,20,12"
                      IsVisible="{Binding AutoStopVisible}">
                    <ProgressBar Grid.Column="0" Minimum="0" Maximum="300" Height="8"
                                 MinHeight="8" CornerRadius="4"
                                 Value="{Binding AutoStopProgress}"
                                 Foreground="{StaticResource TeavelStarBrush}"
                                 Background="#55FFFFFF"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding AutoStopText}"
                               Foreground="White" FontSize="11" VerticalAlignment="Center" />
                </Grid>

                <!-- 수업 시작 / 종료 -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="20,0">
                    <Button Grid.Column="0" Classes="primary" Content="수업 시작"
                            Command="{Binding StartSessionCommand}"
                            IsEnabled="{Binding CanStart}"
                            Height="52" FontSize="16"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Button Grid.Column="1" Classes="outline" Content="수업 종료"
                            Command="{Binding StopSessionCommand}"
                            IsEnabled="{Binding CanStop}"
                            Height="52" FontSize="16"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ── 기기 목록 ── -->
        <ListBox Grid.Row="1" Name="DeviceList" ItemsSource="{Binding Devices}"
                 Background="Transparent" Padding="0,12"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DeviceViewModel">
                    <Border Classes="card" ClipToBounds="True" MinHeight="68">
                        <Grid ColumnDefinitions="4,Auto,*,Auto">
                            <!-- 좌측 상태 색상 띠 -->
                            <Border Grid.Column="0" Background="{Binding StatusBrush}" />

                            <CheckBox Grid.Column="1" Margin="10,0,6,0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                            <StackPanel Grid.Column="2" Margin="0,14,10,14" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding NameWithBadge}"
                                               FontSize="15" FontWeight="Bold"
                                               Foreground="{StaticResource TeavelInkBrush}" />
                                    <!-- 학적 수정 요청 표시 -->
                                    <v:LineIcon Kind="edit" Width="15" Height="15"
                                                VerticalAlignment="Center"
                                                Stroke="{StaticResource TeavelAccentBrush}"
                                                IsVisible="{Binding EditRequest}"
                                                ToolTip.Tip="학적 수정 요청" />
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                    <v:LineIcon Grid.Column="0" Kind="{Binding StatusIcon}"
                                                Stroke="{Binding StatusBrush}"
                                                Width="14" Height="14" Margin="0,1,5,0"
                                                VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="muted"
                                               FontSize="12" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>

                            <!-- 상태 점 -->
                            <Ellipse Grid.Column="3" Width="10" Height="10" Margin="0,0,18,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding StatusBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
