<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClassroomController.Views.AppSelectionWindow"
        Width="380" Height="560"
        MinWidth="320" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Title="허용 앱 설정">
    <Grid RowDefinitions="Auto,*,Auto" Margin="16">
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,10">
            <TextBlock Text="허용 앱 설정" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="수업 중 학생이 사용할 수 있는 앱을 선택하세요. (기본) 앱은 정상 동작에 필요합니다."
                       TextWrapping="Wrap" Foreground="#616161" FontSize="12" />
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6">
            <ScrollViewer>
                <StackPanel Name="AppList" Margin="10" Spacing="2" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,12,0,0">
            <Button Grid.Column="0" Content="취소"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Click="OnCancel" />
            <Button Grid.Column="1" Content="확인"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="#1976d2" Foreground="White"
                    Click="OnConfirm" />
        </Grid>
    </Grid>
</Window>
