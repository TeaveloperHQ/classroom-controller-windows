<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClassroomController.App"
             RequestedThemeVariant="Light">

    <!-- Teavel 브랜드 팔레트 (Android ClassroomController colors.xml 과 동일) -->
    <Application.Resources>
        <Color x:Key="TeavelBrandIndigo">#6366F1</Color>
        <Color x:Key="TeavelBrandViolet">#8B5CF6</Color>
        <Color x:Key="TeavelBrandCyan">#06B6D4</Color>
        <Color x:Key="TeavelAccent">#4F46E5</Color>
        <Color x:Key="TeavelAccentHover">#4338CA</Color>

        <SolidColorBrush x:Key="TeavelAccentBrush" Color="#4F46E5" />
        <SolidColorBrush x:Key="TeavelStarBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="TeavelDangerBrush" Color="#E11D48" />
        <SolidColorBrush x:Key="TeavelSuccessBrush" Color="#10B981" />
        <SolidColorBrush x:Key="TeavelWarningBrush" Color="#F97316" />
        <SolidColorBrush x:Key="TeavelOfflineBrush" Color="#94A3B8" />
        <SolidColorBrush x:Key="TeavelInkBrush" Color="#0F1226" />
        <SolidColorBrush x:Key="TeavelInkMutedBrush" Color="#64748B" />
        <SolidColorBrush x:Key="TeavelSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TeavelSurfaceAltBrush" Color="#F8FAFC" />
        <SolidColorBrush x:Key="TeavelBorderBrush" Color="#E2E8F0" />

        <!-- 헤더 배지 / 기본 버튼: indigo → violet → cyan -->
        <LinearGradientBrush x:Key="TeavelBrandGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#6366F1" />
            <GradientStop Offset="0.5" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#06B6D4" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TeavelBrandGradientPressed" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#4338CA" />
            <GradientStop Offset="0.5" Color="#8B5CF6" />
            <GradientStop Offset="1" Color="#06B6D4" />
        </LinearGradientBrush>

        <!-- 창 배경: lavender → mint -->
        <LinearGradientBrush x:Key="TeavelScreenGradient" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Offset="0" Color="#EEF2FF" />
            <GradientStop Offset="0.5" Color="#F5F3FF" />
            <GradientStop Offset="1" Color="#ECFEFF" />
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#FF4F46E5" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource TeavelScreenGradient}" />
            <Setter Property="Foreground" Value="{StaticResource TeavelInkBrush}" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource TeavelInkMutedBrush}" />
        </Style>

        <!-- 기본(Primary) 버튼: 그라데이션 + 흰 글씨 -->
        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource TeavelBrandGradient}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TeavelBrandGradientPressed}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TeavelBrandGradientPressed}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TeavelBrandGradient}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 보조(Outline) 버튼: 흰 바탕 + 테두리 -->
        <Style Selector="Button.outline">
            <Setter Property="Foreground" Value="{StaticResource TeavelInkBrush}" />
            <Setter Property="Background" Value="{StaticResource TeavelSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TeavelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.outline:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TeavelSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TeavelAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TeavelInkBrush}" />
        </Style>
        <Style Selector="Button.outline:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TeavelSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TeavelAccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TeavelInkBrush}" />
        </Style>
        <Style Selector="Button.outline:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.outline:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource TeavelSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TeavelBorderBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TeavelInkBrush}" />
        </Style>

        <!-- 거절 등 위험 텍스트 버튼 -->
        <Style Selector="Button.dangerText">
            <Setter Property="Foreground" Value="{StaticResource TeavelDangerBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.dangerText:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FFFECDD3" />
            <Setter Property="Foreground" Value="{StaticResource TeavelDangerBrush}" />
        </Style>

        <!-- 그라데이션 헤더 위의 아이콘 버튼 -->
        <Style Selector="Button.onBrand">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
        <Style Selector="Button.onBrand:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.onBrand:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#55FFFFFF" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- 카드 (흰 바탕 + 1px 테두리) -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource TeavelSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource TeavelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Application.Styles>
</Application>
